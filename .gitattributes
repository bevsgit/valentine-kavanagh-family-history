# Normalise line endings so a build on Windows and a build in Linux CI
# produce identical bytes. Without this every local rebuild shows thousands
# of phantom changed lines and the history becomes useless.
* text=auto eol=lf

# Never touch these
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.pdf   binary
*.xlsx  binary
*.zip   binary
*.ico   binary

# Text, explicitly
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
